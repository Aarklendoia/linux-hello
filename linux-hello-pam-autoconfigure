#!/bin/bash
# Linux Hello — automatic PAM activation for sudo.
#
# Run unattended, as root, by linux-hello-pam-autoconfigure.timer (systemd).
# As soon as any local user has enrolled at least one face, this enables the
# linux-hello pam-auth-update profile, which wires pam_linux_hello.so in for
# sudo/su/polkit — never for sddm (a separate, opt-in path via
# install-pam.sh, since it starts an always-on root listener — see
# docs/PAM_MODULE.md). Screenlock unlocking doesn't use PAM at all; see the
# note near the bottom of this script.
#
# This is safe to run repeatedly and safe on multi-user machines: the PAM
# module already falls back to the password for any UID with no enrolled
# face (NoEnrollment -> PAM_IGNORE), so a single system-wide activation is
# correct regardless of which users have actually enrolled.
#
# Respects an explicit opt-out: if install-pam.sh --remove was run, this
# script does nothing until a manual install-pam.sh run re-enables it.

set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
# LH_PAM_LIB overrides it for testing a checkout on a machine where the
# package is also installed.
if [[ -n "${LH_PAM_LIB:-}" ]]; then
    # shellcheck source=pam-lib.sh
    source "$LH_PAM_LIB"
elif [[ -f /usr/lib/linux-hello/pam-lib.sh ]]; then
    # shellcheck source=pam-lib.sh
    source /usr/lib/linux-hello/pam-lib.sh
else
    # Running from a repo checkout (development/testing).
    # shellcheck source=pam-lib.sh
    source "$SCRIPT_DIR/pam-lib.sh"
fi

log() { echo "linux-hello-pam-autoconfigure: $*"; }

if [[ "$EUID" -ne 0 && -z "${LH_SKIP_ROOT_CHECK:-}" ]]; then
    log "must be run as root, exiting"
    exit 1
fi

# ── Locking ──────────────────────────────────────────────────────────────────
# Non-blocking: this runs every few minutes, so if install-pam.sh is doing an
# interactive edit right now, just skip this run rather than wait.
lh_acquire_lock_fd
if ! flock -n 9; then
    log "another linux-hello PAM operation is in progress, skipping this run"
    exit 0
fi

# ── Find any enrolled face across all real local users ───────────────────────
# Mirrors the /etc/passwd parsing style already used in
# hello_daemon/src/pam_helper.rs (no getent dependency). Known limitation:
# this won't see systemd-homed accounts, which aren't real /etc/passwd lines.
#
# Computed up front, before the "already configured"/"disabled" early exits
# below — the pending-reboot warning right after this needs it regardless of
# whether PAM activation itself has anything left to do this run.
#
# LOGIN_DEFS/PASSWD_FILE/ROOT_STORAGE_DIR are overridable for testing against
# a scratch environment instead of the real system paths.
LOGIN_DEFS="${LOGIN_DEFS:-/etc/login.defs}"
PASSWD_FILE="${PASSWD_FILE:-/etc/passwd}"
ROOT_STORAGE_DIR="${ROOT_STORAGE_DIR:-/var/lib/linux-hello}"

uid_min=1000
uid_max=60000
if [[ -f "$LOGIN_DEFS" ]]; then
    v=$(awk '/^UID_MIN/{print $2}' "$LOGIN_DEFS" 2>/dev/null || true)
    [[ -n "$v" ]] && uid_min="$v"
    v=$(awk '/^UID_MAX/{print $2}' "$LOGIN_DEFS" 2>/dev/null || true)
    [[ -n "$v" ]] && uid_max="$v"
fi

has_enrollment=0

# Root/system-mode storage, if the daemon was ever run as root.
if [[ -d "$ROOT_STORAGE_DIR/users" ]] &&
   find "$ROOT_STORAGE_DIR/users" -maxdepth 2 -name '*.meta.json' -print -quit 2>/dev/null | grep -q .; then
    has_enrollment=1
    log "found an enrolled face under $ROOT_STORAGE_DIR/users"
fi

if [[ "$has_enrollment" -eq 0 ]]; then
    while IFS=: read -r _name _pass uid _gid _gecos home _shell; do
        [[ "$uid" =~ ^[0-9]+$ ]] || continue
        (( uid >= uid_min && uid <= uid_max )) || continue
        [[ -d "$home" ]] || continue
        faces_dir="$home/.local/share/linux-hello/users"
        [[ -d "$faces_dir" ]] || continue
        if find "$faces_dir" -maxdepth 2 -name '*.meta.json' -print -quit 2>/dev/null | grep -q .; then
            has_enrollment=1
            log "found an enrolled face for uid=$uid"
            break
        fi
    done < "$PASSWD_FILE"
fi

# No pending-reboot warning here anymore (removed, issue #181): embeddings
# and the KWallet password cache are now sealed to PCR7 (Secure Boot policy
# state) only, not the bootloader/kernel/initrd measurements that change on
# an ordinary kernel update — see hello_daemon's tpm_seal.rs. Ubuntu's
# /var/run/reboot-required is set for many reasons unrelated to Secure Boot
# (most commonly just a kernel or library update), so under the current
# design it would almost always be a false alarm; there's no simple,
# existing signal for "the Secure Boot certificate database is about to
# change" (a firmware update via fwupd, or manual key enrollment) to warn
# on instead.

if lh_pam_autoconfig_disabled; then
    log "automatic activation disabled ($LH_OPTOUT_MARKER present), skipping"
    exit 0
fi

if lh_has_legacy_config; then
    # Normally already done by libpam-linux-hello's postinst; retried here in
    # case it failed there (locally modified common-auth).
    log "configuration from an earlier version found, migrating to the pam-auth-update profile"
    if lh_migrate_legacy_config; then
        log "migration done"
    else
        log "migration failed, the earlier per-service configuration was left in place"
        exit 1
    fi
    exit 0
fi

if lh_profile_enabled; then
    log "already configured, nothing to do"
    exit 0
fi

if [[ ! -f "$(lh_module_path)" ]]; then
    log "PAM module not installed at $(lh_module_path), skipping (is libpam-linux-hello installed?)"
    exit 0
fi

if [[ "$has_enrollment" -eq 0 ]]; then
    log "no enrolled faces found yet, nothing to do"
    exit 0
fi

# ── Configure ─────────────────────────────────────────────────────────────────
# One line in common-auth, through the pam-auth-update profile: the module
# then handles sudo/sudo-i/su/su-l (with confirmation) and polkit-1, and
# ignores every other service (see pam_linux_hello's
# auto_context_for_service). Nothing is written to those services' own
# /etc/pam.d files (#215). SDDM stays off until install-pam.sh
# --enable-sddm creates its marker.
#
# Screenlock unlocking doesn't go through PAM at all: hello-daemon's own
# watcher polls org.freedesktop.ScreenSaver and unlocks via `loginctl
# unlock-session` on a face match (see hello_daemon/src/screenlock.rs).
log "enrolled face(s) found, enabling the linux-hello PAM profile (sudo, su, polkit)"
if lh_profile_enable; then
    log "done"
else
    log "could not enable the PAM profile, see the message above"
    exit 1
fi
