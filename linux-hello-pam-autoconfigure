#!/bin/bash
# Linux Hello — automatic PAM activation for sudo.
#
# Run unattended, as root, by linux-hello-pam-autoconfigure.timer (systemd).
# As soon as any local user has enrolled at least one face, this configures
# pam_linux_hello.so for sudo/su/polkit — never for sddm (a separate, opt-in
# path via install-pam.sh, since it starts an always-on root listener — see
# docs/PAM_MODULE.md). Screenlock unlocking doesn't use PAM at all; see the
# note near the bottom of this script.
#
# This is safe to run repeatedly and safe on multi-user machines: the PAM
# module already falls back to the password for any UID with no enrolled
# face (NoEnrollment -> PAM_IGNORE), so a single system-wide activation is
# correct regardless of which users have actually enrolled.
#
# Respects an explicit opt-out: if install-pam.sh --remove was run, this
# script does nothing until a manual install-pam.sh run re-enables it.

set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
if [[ -f /usr/lib/linux-hello/pam-lib.sh ]]; then
    # shellcheck source=pam-lib.sh
    source /usr/lib/linux-hello/pam-lib.sh
else
    # Running from a repo checkout (development/testing).
    # shellcheck source=pam-lib.sh
    source "$SCRIPT_DIR/pam-lib.sh"
fi

log() { echo "linux-hello-pam-autoconfigure: $*"; }

if [[ "$EUID" -ne 0 && -z "${LH_SKIP_ROOT_CHECK:-}" ]]; then
    log "must be run as root, exiting"
    exit 1
fi

# ── Locking ──────────────────────────────────────────────────────────────────
# Non-blocking: this runs every few minutes, so if install-pam.sh is doing an
# interactive edit right now, just skip this run rather than wait.
lh_acquire_lock_fd
if ! flock -n 9; then
    log "another linux-hello PAM operation is in progress, skipping this run"
    exit 0
fi

# ── Find any enrolled face across all real local users ───────────────────────
# Mirrors the /etc/passwd parsing style already used in
# hello_daemon/src/pam_helper.rs (no getent dependency). Known limitation:
# this won't see systemd-homed accounts, which aren't real /etc/passwd lines.
#
# Computed up front, before the "already configured"/"disabled" early exits
# below — the pending-reboot warning right after this needs it regardless of
# whether PAM activation itself has anything left to do this run.
#
# LOGIN_DEFS/PASSWD_FILE/ROOT_STORAGE_DIR are overridable for testing against
# a scratch environment instead of the real system paths.
LOGIN_DEFS="${LOGIN_DEFS:-/etc/login.defs}"
PASSWD_FILE="${PASSWD_FILE:-/etc/passwd}"
ROOT_STORAGE_DIR="${ROOT_STORAGE_DIR:-/var/lib/linux-hello}"

uid_min=1000
uid_max=60000
if [[ -f "$LOGIN_DEFS" ]]; then
    v=$(awk '/^UID_MIN/{print $2}' "$LOGIN_DEFS" 2>/dev/null || true)
    [[ -n "$v" ]] && uid_min="$v"
    v=$(awk '/^UID_MAX/{print $2}' "$LOGIN_DEFS" 2>/dev/null || true)
    [[ -n "$v" ]] && uid_max="$v"
fi

has_enrollment=0

# Root/system-mode storage, if the daemon was ever run as root.
if [[ -d "$ROOT_STORAGE_DIR/users" ]] &&
   find "$ROOT_STORAGE_DIR/users" -maxdepth 2 -name '*.meta.json' -print -quit 2>/dev/null | grep -q .; then
    has_enrollment=1
    log "found an enrolled face under $ROOT_STORAGE_DIR/users"
fi

if [[ "$has_enrollment" -eq 0 ]]; then
    while IFS=: read -r _name _pass uid _gid _gecos home _shell; do
        [[ "$uid" =~ ^[0-9]+$ ]] || continue
        (( uid >= uid_min && uid <= uid_max )) || continue
        [[ -d "$home" ]] || continue
        faces_dir="$home/.local/share/linux-hello/users"
        [[ -d "$faces_dir" ]] || continue
        if find "$faces_dir" -maxdepth 2 -name '*.meta.json' -print -quit 2>/dev/null | grep -q .; then
            has_enrollment=1
            log "found an enrolled face for uid=$uid"
            break
        fi
    done < "$PASSWD_FILE"
fi

# ── Pending-reboot warning for embedding-key TPM fragility (#160) ───────────
# Embeddings are encrypted at rest with a key sealed to boot-integrity PCRs
# (secure boot state + bootloader/kernel — see hello_daemon's tpm_seal.rs /
# embedding_cipher.rs). That key can never be unsealed again once those
# measurements change across a reboot, permanently invalidating every
# enrolled face with no recovery but re-enrollment. Ubuntu's own
# /var/run/reboot-required (written by kernel/dependency postinst hooks
# whenever a reboot is needed to pick up a change) is a reasonable,
# already-correct proxy for "the next reboot risks doing exactly that" —
# reused here rather than reinventing boot-measurement prediction. This is a
# best-effort heads-up (checked every 5 minutes by this timer), not a
# guarantee: a reboot happening in the few minutes before the next tick, or
# not going through PackageKit/apt at all, won't be caught in time. Runs
# unconditionally (even if PAM activation below has nothing left to do, or is
# opted out) — this warning is about TPM/embedding fragility, unrelated to
# PAM configuration state.
REBOOT_REQUIRED_FILE="${REBOOT_REQUIRED_FILE:-/var/run/reboot-required}"
if [[ "$has_enrollment" -eq 1 && -f "$REBOOT_REQUIRED_FILE" ]]; then
    log "WARNING: a reboot is pending ($REBOOT_REQUIRED_FILE exists) and at least one face is enrolled — rebooting may invalidate encrypted face data sealed to the current boot state (https://github.com/Aarklendoia/linux-hello/issues/160). Re-enroll (linux-hello enroll <uid>) after rebooting if face login stops working."
fi

if lh_pam_autoconfig_disabled; then
    log "automatic activation disabled ($LH_OPTOUT_MARKER present), skipping"
    exit 0
fi

if lh_all_configured; then
    log "already fully configured, nothing to do"
    exit 0
fi

if [[ ! -f "$(lh_module_path)" ]]; then
    log "PAM module not installed at $(lh_module_path), skipping (is libpam-linux-hello installed?)"
    exit 0
fi

if [[ "$has_enrollment" -eq 0 ]]; then
    log "no enrolled faces found yet, nothing to do"
    exit 0
fi

# ── Configure ─────────────────────────────────────────────────────────────────
log "enrolled face(s) found, activating PAM for sudo/screenlock"

lh_configure_service "sudo"   "sudo" "@include common-auth" "confirm" || true
lh_configure_service "sudo-i" "sudo" "@include common-auth" "confirm" || true
lh_configure_service "su"     "sudo" "@include common-auth" "confirm" || true
lh_configure_service "su-l"   "sudo" "@include common-auth" "confirm" || true

# No `nullok` on the pam_unix.so fallback line: nullok makes pam_unix.so
# treat an empty password hash as authenticated on an empty input, which
# would silently defeat the "password is always the real fallback"
# guarantee this whole script is built around for any account that ends up
# with one (e.g. `passwd -d`, or a misconfigured account). Stock
# Debian/Ubuntu common-auth doesn't use nullok either — don't reintroduce it
# here.
POLKIT_FILE="$PAM_DIR/polkit-1"
if [[ ! -f "$POLKIT_FILE" ]]; then
    cat > "$POLKIT_FILE" << 'EOF'
#%PAM-1.0
# Linux Hello - Authentication for polkit dialogs (pkexec, graphical elevation)
# auth sufficient = if biometrics OK → access granted; otherwise → password fallback

auth       sufficient   pam_linux_hello.so context=polkit
auth       required     pam_unix.so
@include common-account
EOF
    log "service polkit-1: created with linux-hello + password fallback"
else
    lh_configure_service "polkit-1" "polkit" "^auth" || true
fi

# Screenlock unlocking doesn't go through PAM at all: hello-daemon's own
# watcher polls org.freedesktop.ScreenSaver and unlocks via `loginctl
# unlock-session` on a face match (see hello_daemon/src/screenlock.rs),
# so there's no PAM service to configure here.

# sddm is intentionally never touched here — see header comment.

log "done"
