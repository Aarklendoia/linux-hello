# Maintainer: Linux Hello Team <dev@linuxhello.local>
#
# Arch counterpart to the project's Debian/Ubuntu packaging under debian/ —
# mirrors the same split (daemon / models / pam / tools / gui), same systemd
# units. Built by .github/workflows/build-arch.yml
# and attached to each GitHub release. See GitHub issue #111 for the
# non-obvious gaps this had to work around:
#
#   - The KDE lock-screen QML overlay (dpkg-divert on Debian) has no pacman
#     equivalent, AND Plasma 6 on Arch compiles the lock-screen UI into a
#     binary resource — there is no on-disk QML file to divert or replace at
#     all. Not shipped.
#   - The SDDM greeter overlay (Login.qml) isn't shipped either: it could
#     only ever be a reference copy here, not wired into any theme.
#
# PAM is NOT configured automatically here, unlike Debian. install-pam.sh,
# pam-lib.sh and linux-hello-pam-autoconfigure assume Debian's
# `@include common-auth` stacks and dpkg-divert, so they aren't shipped
# (which also greys out the GUI's SDDM toggle, by design — see
# linux_hello_config's install_pam_available). The manual steps are in
# docs/PAM_MODULE.md ("Manual setup on other distributions"), and
# linux-hello-pam.install prints them.
#
# The ONNX face models aren't shipped (#211): InsightFace's terms only allow
# non-commercial research use and don't grant redistribution, and these
# packages are attached to GitHub releases. `sudo linux-hello models install`
# shows those terms and fetches them; linux-hello-models is kept, empty, so
# that upgrading from a version that shipped them keeps the local copy (see
# linux-hello-models.install).

pkgbase=linux-hello
pkgname=(linux-hello linux-hello-daemon linux-hello-models linux-hello-pam linux-hello-tools linux-hello-gui)
pkgver=1.12.3 # x-release-please-version
pkgrel=1
arch=('x86_64' 'aarch64')
url="https://github.com/Aarklendoia/linux-hello"
license=('GPL-3.0-or-later')
makedepends=(
  'rust' 'clang' 'pkgconf'
  'pam' 'tpm2-tss'
  # A split PKGBUILD must be able to install every sub-package's depends at
  # build time (namcap); these are the ones nothing above pulls in.
  'dbus' 'systemd' 'polkit' 'onnxruntime-cpu'
  'qt6-declarative' 'kirigami' 'qqc2-desktop-style'
)
source=(
  "$pkgbase-$pkgver.tar.gz::https://github.com/Aarklendoia/linux-hello/archive/refs/tags/v$pkgver.tar.gz"
)
sha256sums=('SKIP')

prepare() {
  cd "$srcdir/$pkgbase-$pkgver"
  # No Cargo.lock is committed upstream (project convention, same as the
  # non-vendored Debian build path) — cargo fetch resolves it fresh here
  # and populates the local registry cache for the --offline build/check
  # below.
  cargo fetch --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/$pkgbase-$pkgver"
  # The models aren't shipped (see the header): build.rs mustn't fetch them.
  export LINUX_HELLO_NO_MODEL_DOWNLOAD=1
  export RUSTUP_TOOLCHAIN=stable
  # The workspace release profile uses lto=true + codegen-units=1 (fat LTO,
  # single codegen unit) for runtime performance. That makes the *final
  # link* of each binary pulling in hello_face_core (tract/onnx) do a
  # whole-dependency-graph LTO merge, which is extremely memory-hungry —
  # observed: individual link jobs alone using 5.6+ GB RSS, and two of them
  # running concurrently was enough to exhaust 16GB and get SIGKILL'd by the
  # OOM killer. Only those final links need serializing, not the ~550
  # dependency crates (`--jobs 1` used to serialize everything: 26 min), so
  # build one final artifact per cargo invocation: the first compiles the
  # dependencies in parallel, and each does exactly one LTO link.
  local target
  for target in '--bin hello-daemon' '--bin hello-daemon-system' \
                '--bin linux-hello' '--bin linux_hello_config' \
                '--package pam_linux_hello --lib'; do
    # shellcheck disable=SC2086 # $target is deliberately word-split
    cargo build --release --offline $target
  done
}

check() {
  cd "$srcdir/$pkgbase-$pkgver"
  # Without the models, the tests that would load them skip themselves.
  export LINUX_HELLO_NO_MODEL_DOWNLOAD=1
  # Same standard fallback candidate onnxruntime-cpu installs at on Arch —
  # without it, ort's own lookup can hang indefinitely instead of failing
  # fast (see hello_face_core::ensure_ort_dylib_path's doc comment).
  export ORT_DYLIB_PATH=/usr/lib/libonnxruntime.so
  # The workspace's `ci` profile (no LTO, 16 codegen units — what the Tests
  # workflow runs) instead of `--release`: tests don't need the shipped
  # binaries' fat LTO, which made this step rebuild and LTO-link every test
  # binary one at a time (40 min). It builds into target/ci/, so it can't
  # touch the target/release/ binaries package() installs.
  cargo test --profile ci --workspace --offline
}

package_linux-hello() {
  pkgdesc="Face Authentication System for Linux (metapackage)"
  depends=("linux-hello-daemon=$pkgver-$pkgrel" "linux-hello-tools=$pkgver-$pkgrel" "linux-hello-pam=$pkgver-$pkgrel")
}

package_linux-hello-daemon() {
  pkgdesc="Face Authentication System for Linux — daemon"
  depends=('dbus' 'systemd' 'polkit' 'tpm2-tss' 'onnxruntime-cpu' "linux-hello-models=$pkgver-$pkgrel")
  optdepends=('tpm2-abrmd: TPM-sealed face embeddings for the per-user daemon')
  cd "$srcdir/$pkgbase-$pkgver"

  install -Dm755 target/release/hello-daemon "$pkgdir/usr/bin/hello-daemon"
  install -Dm644 hello-daemon.service "$pkgdir/usr/lib/systemd/user/hello-daemon.service"
  # Arch's onnxruntime-cpu installs the unversioned libonnxruntime.so (no
  # Debian-style multiarch path): drop the unit's Debian path and let
  # hello_face_core::ensure_ort_dylib_path's fallback find it (#134, #135).
  sed -i '/^Environment=ORT_DYLIB_PATH=/d' "$pkgdir/usr/lib/systemd/user/hello-daemon.service"

  install -Dm644 debian/polkit/com.linuxhello.manage-faces.policy \
    "$pkgdir/usr/share/polkit-1/actions/com.linuxhello.manage-faces.policy"
  # Lets an ordinary user's hello-daemon reach tpm2-abrmd — see the file's
  # own comment (issue #152).
  install -Dm644 debian/dbus/linux-hello-tabrmd.conf \
    "$pkgdir/usr/share/dbus-1/system.d/linux-hello-tabrmd.conf"

  # tmpfiles.d: same entries as debian/rules (see it for the rationale —
  # pre-creating the lock files closes a symlink-planting race before any
  # session starts; secrets/ holds hello-daemon-system's TPM-sealed blobs).
  install -d "$pkgdir/usr/lib/tmpfiles.d"
  printf 'd /run/hello-pam 1777 root root -\nf /run/lock/linux-hello-camera.lock 0666 root root -\nf /run/lock/linux-hello-pam.lock 0600 root root -\nd /var/lib/linux-hello/secrets 0700 root root -\n' \
    > "$pkgdir/usr/lib/tmpfiles.d/linux-hello.conf"

  install -Dm644 README.md "$pkgdir/usr/share/doc/linux-hello/README.md"
  install -Dm644 docs/QUICKSTART.md "$pkgdir/usr/share/doc/linux-hello/QUICKSTART.md"
  install -Dm644 docs/INTEGRATION_GUIDE.md "$pkgdir/usr/share/doc/linux-hello/INTEGRATION_GUIDE.md"
  install -Dm644 docs/PAM_MODULE.md "$pkgdir/usr/share/doc/linux-hello/PAM_MODULE.md"
  install -Dm644 docs/DBUS_API.md "$pkgdir/usr/share/doc/linux-hello/DBUS_API.md"
  install -Dm644 docs/dbus/com.linuxhello.FaceAuth.xml \
    "$pkgdir/usr/share/dbus-1/interfaces/com.linuxhello.FaceAuth.xml"
  install -Dm644 linux-hello.config.toml.example "$pkgdir/etc/linux-hello/config.toml.example"
}

package_linux-hello-models() {
  pkgdesc="Linux Hello face models: not shipped, install with 'sudo linux-hello models install'"
  arch=('any')
  depends=()
  install=linux-hello-models.install
}

package_linux-hello-pam() {
  pkgdesc="PAM module for Linux Hello"
  depends=('pam' 'systemd' 'tpm2-tss' "linux-hello-daemon=$pkgver-$pkgrel" "linux-hello-tools=$pkgver-$pkgrel")
  install=linux-hello-pam.install
  cd "$srcdir/$pkgbase-$pkgver"

  # Flat, non-multiarch security module dir — Arch's PAM looks here.
  install -Dm755 target/release/libpam_linux_hello.so \
    "$pkgdir/usr/lib/security/pam_linux_hello.so"

  # SDDM listener: only started once the user opts in (see the .install
  # message and docs/PAM_MODULE.md).
  install -Dm755 target/release/hello-daemon-system "$pkgdir/usr/bin/hello-daemon-system"
  install -Dm644 hello-daemon-system.service \
    "$pkgdir/usr/lib/systemd/system/hello-daemon-system.service"
  sed -i '/^Environment=ORT_DYLIB_PATH=/d' \
    "$pkgdir/usr/lib/systemd/system/hello-daemon-system.service"
}

package_linux-hello-tools() {
  pkgdesc="Command-line tools for Linux Hello"
  # curl and unzip: `linux-hello models install`.
  depends=('dbus' 'pam' 'curl' 'unzip' "linux-hello-daemon=$pkgver-$pkgrel")
  cd "$srcdir/$pkgbase-$pkgver"
  install -Dm755 target/release/linux-hello "$pkgdir/usr/bin/linux-hello"
}

package_linux-hello-gui() {
  pkgdesc="Configuration GUI for Linux Hello"
  # The UI runs in Qt's own qml6 runtime, with the org.kde.desktop Controls
  # style forced (see linux_hello_config's main.rs).
  depends=(
    'polkit' "linux-hello-daemon=$pkgver-$pkgrel"
    'qt6-declarative' 'kirigami' 'qqc2-desktop-style' 'hicolor-icon-theme'
  )
  optdepends=('plasma-desktop: native KDE Plasma integration')
  cd "$srcdir/$pkgbase-$pkgver"

  install -Dm755 target/release/linux_hello_config "$pkgdir/usr/bin/linux_hello_config"
  install -Dm644 linux-hello.desktop "$pkgdir/usr/share/applications/linux-hello.desktop"
  install -Dm644 linux-hello.metainfo.xml "$pkgdir/usr/share/metainfo/linux-hello.metainfo.xml"
  install -Dm644 linux_hello_config/qml/icons/app-icon.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/linux-hello.svg"

  # Distro-neutral location linux_hello_config's find_qml_path() already
  # checks (and puts on QML_IMPORT_PATH) — Qt's own import dir differs per
  # distro (/usr/lib/qt6/qml here), and the GUI doesn't look there.
  install -d "$pkgdir/usr/share/linux-hello/qml-modules/Linux/Hello"
  cp -r linux_hello_config/qml/* "$pkgdir/usr/share/linux-hello/qml-modules/Linux/Hello/"
}
