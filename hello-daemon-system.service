[Unit]
Description=Linux Hello - system listener for SDDM (login screen) biometric auth
Documentation=file:///usr/share/doc/linux-hello/PAM_MODULE.md
After=dbus.service
# Must be ready before the greeter can accept the very first login attempt
# of a boot — without this ordering, a fast boot could race SDDM's start
# against ONNX model loading + camera scan here, causing a confusing
# first-login-only failure (silent password fallback, ECONNREFUSED).
Before=display-manager.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/hello-daemon-system
Environment=ORT_DYLIB_PATH=/usr/lib/x86_64-linux-gnu/libonnxruntime.so.1.23
Restart=on-failure
RestartSec=2s

# Reads arbitrary local users' home directories (read-only, to check for
# enrolled faces at login time) — cannot use ProtectHome=yes like the
# per-user hello-daemon.service unit.
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=true
# /var/lib/linux-hello/secrets holds the TPM-sealed key and encrypted
# password blob for the KWallet auto-unlock cache (hello_daemon::secret_cache)
# — root-owned, created by tmpfiles.d (see debian/rules), deliberately kept
# out of any user's home directory so ProtectHome=read-only above doesn't
# need to be loosened for it.
ReadWritePaths=/run/hello-pam /run/lock /var/lib/linux-hello/secrets

# Additional sandboxing — see hello-daemon.service's own comment and issue
# #179 for how each of these was checked. This unit opens no TCP sockets at
# all (only its three Unix-domain listeners, see its module doc), so
# RestrictAddressFamilies is narrower here than on the per-user unit.
# Deliberately excludes MemoryDenyWriteExecute, CapabilityBoundingSet, and
# any DeviceAllow restriction for the same reasons as hello-daemon.service —
# this unit additionally needs to read arbitrary local users' home
# directories and touch the TPM device directly as root, so under-scoping
# either would risk silently breaking SDDM login rather than just camera
# preview. Not live-tested against this specific binary (see #179) —
# verify with a real reboot before/along the next beta cycle.
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
PrivateTmp=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX

TimeoutStartSec=15
TimeoutStopSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hello-daemon-system

[Install]
WantedBy=multi-user.target
