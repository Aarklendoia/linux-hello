#!/bin/bash
# Postinstallation script for linux-hello-daemon

set -e

echo "Linux Hello - Postinstallation Configuration"
echo "=============================================="
echo ""

# Create storage directory
STORAGE_DIR="${HOME}/.local/share/linux-hello"
mkdir -p "$STORAGE_DIR" 2>/dev/null || true
chmod 700 "$STORAGE_DIR" 2>/dev/null || true

echo "✓ Daemon service installed"

# Create /run/hello-pam/ immediately (will be recreated at boot by systemd-tmpfiles)
if ! systemd-tmpfiles --create /usr/lib/tmpfiles.d/linux-hello.conf 2>/dev/null; then
    mkdir -p /run/hello-pam 2>/dev/null || true
    chmod 1777 /run/hello-pam 2>/dev/null || true
fi
echo "✓ Socket directory /run/hello-pam/ ready"

# Install the KDE lock screen QML overlay via dpkg-divert.
# dpkg-divert moves the plasma-workspace file (renamed .distrib) and puts ours in its place.
# On a plasma-workspace update, dpkg sees the diversion and does not overwrite our file.
PLASMA_QML="/usr/share/plasma/shells/org.kde.plasma.desktop/contents/lockscreen/MainBlock.qml"
LINUX_HELLO_QML="/usr/share/linux-hello/lockscreen/MainBlock.qml"
if [ -f "$LINUX_HELLO_QML" ] && [ -f "$PLASMA_QML" ]; then
    dpkg-divert --package linux-hello-daemon --rename --add "$PLASMA_QML" 2>/dev/null || true
    cp "$LINUX_HELLO_QML" "$PLASMA_QML"
    echo "✓ Lock screen QML overlay installed"
fi

# Enable the per-user daemon for *every* user, not just the one who ran the
# install: `systemctl --global enable` links it into
# /etc/systemd/user/default.target.wants/, so each user's systemd --user
# instance starts it on their next login. This used to be a per-user
# `systemctl --user enable` run only for $SUDO_USER (or the first `who`
# entry), which left every other account on the machine without a daemon
# and unable to enroll a face. (No #DEBHELPER# token here, and
# dh_installsystemduser isn't part of the compat-13 sequence, so nothing
# else does this for us.)
if systemctl --global enable hello-daemon.service 2>/dev/null; then
    echo "✓ Daemon enabled for all users"
else
    echo "! Could not enable hello-daemon.service globally — each user can run: systemctl --user enable --now hello-daemon.service"
fi

# Global enablement only takes effect at the next login; also start it right
# away in every user session already open. `runuser` alone doesn't propagate
# the target user's XDG_RUNTIME_DIR, so `systemctl --user` couldn't find
# their bus — set it explicitly. A failure for one user must not fail the
# whole postinst.
for RUNTIME_DIR in /run/user/*; do
    [ -S "$RUNTIME_DIR/bus" ] || continue
    TARGET_UID=$(basename "$RUNTIME_DIR")
    [ "$TARGET_UID" -ge 1000 ] 2>/dev/null || continue
    TARGET_USER=$(id -nu "$TARGET_UID" 2>/dev/null) || continue
    if runuser -u "$TARGET_USER" -- env XDG_RUNTIME_DIR="$RUNTIME_DIR" \
        sh -c 'systemctl --user daemon-reload && systemctl --user restart hello-daemon.service' 2>/dev/null; then
        echo "✓ Daemon started for user: $TARGET_USER"
    else
        echo "! Could not start hello-daemon.service for $TARGET_USER — it will start at their next login"
    fi
done

# PAM configuration is not done here. If libpam-linux-hello is installed,
# its linux-hello-pam-autoconfigure.timer automatically configures sudo and
# screenlock as soon as any user enrolls a face — see
# /usr/share/doc/linux-hello/PAM_MODULE.md, including how to opt out and
# why the SDDM login screen isn't covered by automatic activation.

echo ""
echo "Installation Complete!"
echo ""
echo "Next steps:"
echo "1. Register a face: linux-hello enroll \$(id -u) --context sudo --samples 3"
echo "2. Test with sudo: sudo -v"
echo "3. Or test with screenlock: lock your screen"
echo ""
echo "For help: man linux-hello"
echo ""

exit 0
