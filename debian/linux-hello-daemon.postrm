#!/bin/bash
# Post-removal cleanup

set -e

# dpkg invokes postrm with "upgrade"/"failed-upgrade"/etc. during package
# upgrades. Empirically (verified via /var/log/apt/term.log), it also calls
# `postrm remove` — not just on a real `apt remove` — when reinstalling the
# identical version via `apt install --reinstall`, since there's no
# meaningful in-place "upgrade" when old and new versions match. Do nothing
# at all outside remove/purge.
case "$1" in
    remove | purge) ;;
    *) exit 0 ;;
esac

echo "Linux Hello - Cleanup"
echo "===================="

# Stop/disable the daemon and undo the lockscreen QML divert on every
# removal (including a same-version --reinstall's "remove" step, see above):
# their target files are gone either way, and postinst puts both back
# immediately on the following install, so there's no user-visible gap.
systemctl --global disable hello-daemon.service 2>/dev/null || true
for RUNTIME_DIR in /run/user/*; do
    [ -S "$RUNTIME_DIR/bus" ] || continue
    TARGET_USER=$(id -nu "$(basename "$RUNTIME_DIR")" 2>/dev/null) || continue
    runuser -u "$TARGET_USER" -- env XDG_RUNTIME_DIR="$RUNTIME_DIR" \
        systemctl --user stop hello-daemon.service 2>/dev/null || true
done

PLASMA_QML="/usr/share/plasma/shells/org.kde.plasma.desktop/contents/lockscreen/MainBlock.qml"
if dpkg-divert --list "$PLASMA_QML" 2>/dev/null | grep -q linux-hello; then
    rm -f "$PLASMA_QML"
    dpkg-divert --package linux-hello-daemon --rename --remove "$PLASMA_QML" 2>/dev/null || true
    echo "✓ Original lock screen QML restored"
fi

# /etc/pam.d/*: since #215 nothing linux-hello does writes to other
# packages' PAM files (libpam-linux-hello's prerm takes its pam-auth-update
# profile out of common-auth). A machine purged without ever being migrated
# may still carry lines from an earlier version, so on purge remove those —
# in place, never by restoring an old backup, which would roll the distro's
# conffile back past any update made since. Only on a real purge, never on
# --reinstall of the same version.
if [ "$1" = "purge" ]; then
    for svc in sudo sudo-i su su-l sddm; do
        f="/etc/pam.d/$svc"
        if [ -f "$f" ] && grep -qE "pam_linux_hello|linux-hello-sddm-auth" "$f" 2>/dev/null; then
            sed -i -e '/^# >>> linux-hello-start$/,/^# <<< linux-hello-end$/d' \
                   -e '/pam_linux_hello/d' -e '/linux-hello-sddm-auth/d' "$f"
            echo "✓ Removed linux-hello lines from $f"
        fi
    done

    # Created from scratch by earlier versions when the distro shipped no
    # /etc/pam.d/polkit-1 — remove it only if it's ours.
    if grep -qF "# Linux Hello - Authentication for polkit dialogs" /etc/pam.d/polkit-1 2>/dev/null; then
        rm -f /etc/pam.d/polkit-1
        echo "✓ Removed /etc/pam.d/polkit-1 (created by linux-hello)"
    fi
    rm -f /etc/pam.d/linux-hello-sddm-auth
    find /etc/pam.d -maxdepth 1 -type f -name "*.pre-linuxhello-*" -delete 2>/dev/null || true
fi

echo ""
echo "Linux Hello uninstalled"
echo ""

exit 0
