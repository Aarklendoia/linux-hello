#!/bin/bash
# Post-installation for libpam-linux-hello
#
# Registers the linux-hello pam-auth-update profile (Default: no, so this
# doesn't enable face auth by itself) and enables the timer that enables it
# once any local user has enrolled a face — linux-hello-pam-autoconfigure's
# job, which respects any existing opt-out marker on its own.
#
# Also migrates a machine configured by an earlier version, which inserted
# lines into other packages' conffiles (/etc/pam.d/sudo, su, sddm, ...) and
# so made every distro update to them a dpkg conffile prompt (#215): the
# profile is enabled first, and only then are those lines removed, so face
# auth never has a gap. If common-auth is locally modified, pam-auth-update
# won't touch it and the old lines are left in place (the timer retries).

set -e

if [ "$1" = "configure" ]; then
    pam-auth-update --package

    if [ -f /usr/lib/linux-hello/pam-lib.sh ]; then
        . /usr/lib/linux-hello/pam-lib.sh
        lh_acquire_lock_fd
        flock -w 15 9 || true
        if ! lh_migrate_legacy_config; then
            echo "⚠ linux-hello: could not migrate the earlier per-service PAM configuration (see above); it was left in place" >&2
        fi
        exec 9>&-
    fi
fi

systemctl daemon-reload 2>/dev/null || true
systemctl enable --now linux-hello-pam-autoconfigure.timer 2>/dev/null || true

# hello-daemon-system.service is opt-in — only install-pam.sh --enable-sddm
# (see pam-lib.sh) ever enables/starts it, deliberately never this postinst,
# so a machine that hasn't opted into SDDM face login stays untouched here.
#
# But if it's ALREADY running, a package upgrade must restart it: it's a
# long-lived root process, so without a restart it keeps executing the OLD
# binary until the next manual restart or reboot. This isn't handled by
# dh_installsystemd's usual auto-generated maintainer-script logic — that
# gets generated (see debian/.debhelper/generated/<pkg>/postinst.service at
# build time), and dh_installdeb splices it in wherever that literal marker
# token appears in this script — note it's spelled out with a space here
# (# DEBHELPER #), not contiguously, precisely so this sentence describing
# it doesn't itself become a splice point. Without the marker anywhere,
# nothing here relied on that splice actually landing correctly — this
# restart is done explicitly instead. This was invisible until the
# encrypted face embeddings migration (#152) made a stale root daemon —
# still reading plaintext files that migration had already deleted —
# actually break SDDM face login outright, instead of just lagging one
# release behind.
if systemctl is-active --quiet hello-daemon-system.service 2>/dev/null; then
    systemctl restart hello-daemon-system.service 2>/dev/null || true
    echo "✓ hello-daemon-system restarted"
fi
