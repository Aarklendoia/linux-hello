#!/bin/bash
# Post-removal for libpam-linux-hello
#
# Stops the automatic-activation timer on removal. The PAM profile itself is
# taken out of common-auth by the prerm, before pam_linux_hello.so goes
# away. The opt-out and SDDM markers under /etc/linux-hello are left alone,
# so a reinstall keeps the admin's choices.

set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    systemctl disable --now linux-hello-pam-autoconfigure.timer 2>/dev/null || true
fi

exit 0
